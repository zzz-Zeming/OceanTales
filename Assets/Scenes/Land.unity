  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: f51a4c22744ab464f9d5efbd79813803, type: 3}
    m_FontSize: 30
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u8760\u9CBC\uFF08f\xFAf\xE8n\uFF09\uFF0C\u53C8\u79F0\u9B54\u9B3C\u9C7C\uFF0C\u5C5E\u4E8E\u8760\u9CBC\u79D1\u8F6F\u9AA8\u9C7C\u7C7B\uFF0C\u5916\u5F62\u72EC\u7279\u4E14\u4E60\u6027\u6781\u5177\u8FA8\u8BC6\u5EA6\uFF0C\u6838\u5FC3\u751F\u6D3B\u4E60\u6027\u5982\u4E0B\uFF1A\r\n\u6816\u606F\u73AF\u5883\r\uFF1A\u504F\u597D\u70ED\u5E26\u3001\u4E9A\u70ED\u5E26\u7684\u5F00\u9614\u6D77\u57DF\uFF08\u6C34\u6DF110-100\u7C73\uFF09\uFF0C\u5076\u5C14\u4F1A\u6E38\u81F3\u8FD1\u6D77\u6D45\u6EE9\u6216\u73CA\u745A\u7901\u9644\u8FD1\uFF0C\u6781\u5C11\u8FDB\u5165\u6DE1\u6C34\u3002\u5B83\u4EEC\u5BF9\u6C34\u6E29\u654F\u611F\uFF0C\u9002\u5B9C\u751F\u5B58\u6E29\u5EA6\u4E3A24-29\u2103\uFF0C\u51AC\u5B63\u4F1A\u5411\u6E29\u6696\u6C34\u57DF\u8FC1\u5F99\u3002\r\n\u98DF\u6027\u7279\u70B9\r\uFF1A\u5178\u578B\u7684\u6EE4\u98DF\u6027\u9C7C\u7C7B\uFF0C\u4EE5\u6D6E\u6E38\u751F\u7269\u3001\u78F7\u867E\u3001\u5C0F\u578B\u7532\u58F3\u7C7B\u548C\u5E7C\u9C7C\u4E3A\u98DF\u3002\u89C5\u98DF\u65F6\u4F1A\u5F20\u5F00\u5BBD\u5927\u7684\u53E3\u90E8\uFF0C\u501F\u52A9\u9CC3\u8019\u8FC7\u6EE4\u6D77\u6C34\uFF0C\u4E00\u6B21\u6027\u541E\u4E0B\u5927\u91CF\u98DF\u7269\uFF1B\u6709\u65F6\u4F1A\u5728\u6C34\u9762\u7F13\u6162\u6E38\u52A8\uFF0C\u751A\u81F3\u8DC3\u51FA\u6C34\u9762\uFF0C\u5E2E\u52A9\u9A71\u6563\u4F53\u8868\u5BC4\u751F\u866B\u3002\r\n\u884C\u4E3A\u4E60\u6027\r\uFF1A\u72EC\u5C45\u4E3A\u4E3B\uFF1A\u591A\u6570\u60C5\u51B5\u4E0B\u5355\u72EC\u6D3B\u52A8\uFF0C\u4EC5\u7E41\u6B96\u671F\u6216\u98DF\u7269\u5145\u8DB3\u65F6\u4F1A\u5C0F\u7FA4\u805A\u96C6\uFF0C\u6027\u683C\u6E29\u987A\uFF0C\u5BF9\u4EBA\u7C7B\u65E0\u653B\u51FB\u6027\u3002\r\u6E38\u6CF3\u65B9\u5F0F\uFF1A\u4F9D\u9760\u5DE8\u5927\u7684\u4E09\u89D2\u5F62\u80F8\u9CCD\u50CF\u201C\u7FC5\u8180\u201D\u4E00\u6837\u7F13\u6162\u6247\u52A8\uFF0C\u6E38\u52A8\u59FF\u6001\u4F18\u96C5\uFF0C\u6700\u9AD8\u6E38\u901F\u53EF\u8FBE\u6BCF\u5C0F\u65F615\u516C\u91CC\uFF1B\u5C3E\u90E8\u7EC6\u957F\u4F46\u65E0\u653B\u51FB\u6027\u6BD2\u523A\uFF08\u533A\u522B\u4E8E\u9B5F\u9C7C\uFF09\u3002\r\u8DC3\u51FA\u6C34\u9762\uFF1A\u90E8\u5206\u8760\u9CBC\u4F1A\u9891\u7E41\u8DC3\u51FA\u6C34\u9762\uFF08\u9AD8\u5EA6\u53EF\u8FBE2\u7C73\uFF09\uFF0C\u539F\u56E0\u63A8\u6D4B\u4E3A\u6C42\u5076\u5C55\u793A\u3001\u8EB2\u907F\u5929\u654C\u6216\u6E05\u7406\u4F53\u8868\u5BC4\u751F\u866B\u3002\r"
