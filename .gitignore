# ============================================================
# Unity 工程 .gitignore
# 只提交 Assets/、Packages/、ProjectSettings/ 三样
# ============================================================

# ---- Unity 自动生成，体积大且可重建 ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity 崩溃日志 / 转储
sysinfo.txt
*.stackdump
crashlytics-build.properties

# ---- IDE 生成物 ----
.vs/
.vsconfig
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- 系统缩略图 / 临时文件 ----
.DS_Store
Thumbs.db
desktop.ini
*~

# ---- 打包产物 ----
*.apk
*.aab
*.unitypackage
*.app

# ---- 例外：Assets 里被 .meta 覆盖的规则不受影响 ----
# 千万不要忽略 .meta，否则 Unity 会重新分配 GUID，场景里的引用会全断
!/[Aa]ssets/**/*.meta
